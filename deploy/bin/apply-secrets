#!/usr/bin/env bash
# Writes the settings and secrets a release brings (KEY=value lines on stdin,
# from the GitHub environment) into /srv/nexus/.env and secrets/lines.txt, and
# rewrites Asterisk's line files when the lines or the provider changed. The
# only thing deploy may run as root. Prints "lines-changed" when Asterisk must
# restart. Never prints a value.
set -euo pipefail

ROOT=${NEXUS_ROOT:-/srv/nexus}
ENV_KEYS=(GEMINI_API_KEY PROVIDER_HOST PROVIDER_ROUTE_NAME DIAL_FORMAT VOICE_AR VOICE_FR HEALTHCHECK_URL)

die() {
  echo "apply-secrets: $*" >&2
  exit 1
}

declare -A values=()
while IFS= read -r line || [[ -n $line ]]; do
  [[ -z $line ]] && continue
  key=${line%%=*}
  case "$key" in
    VOIP_LINES_B64 | GEMINI_API_KEY | PROVIDER_HOST | PROVIDER_ROUTE_NAME | DIAL_FORMAT | VOICE_AR | VOICE_FR | HEALTHCHECK_URL) ;;
    *) die "unknown setting $key" ;;
  esac
  values[$key]=${line#*=}
done

for key in GEMINI_API_KEY VOIP_LINES_B64 PROVIDER_HOST PROVIDER_ROUTE_NAME; do
  [[ -n ${values[$key]:-} ]] || die "$key is empty: add it to the production environment in GitHub"
done
[[ ${values[PROVIDER_HOST]} =~ ^[0-9.]+:[0-9]+$ ]] || die "PROVIDER_HOST must be <ip>:<port>"
[[ ${values[PROVIDER_ROUTE_NAME]} =~ ^[a-z0-9.-]+$ ]] || die "PROVIDER_ROUTE_NAME must be a host name"
[[ ${values[DIAL_FORMAT]:-national} =~ ^(national|international)$ ]] ||
  die "DIAL_FORMAT must be national or international"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# One "<number> <password>" per row; Windows line ends and blank rows dropped.
base64 -d <<<"${values[VOIP_LINES_B64]}" 2>/dev/null | tr -d '\r' | awk 'NF' >"$tmp/lines.txt" ||
  die "VOIP_LINES could not be read"
row=0
while read -r number password extra; do
  row=$((row + 1))
  [[ $number =~ ^[0-9]{6,15}$ && -n $password && -z ${extra:-} ]] ||
    die "VOIP_LINES row $row is not '<number> <password>'"
done <"$tmp/lines.txt"
((row > 0)) || die "VOIP_LINES has no rows"

{
  echo "# Written by apply-secrets on every release; change the GitHub environment instead."
  for key in "${ENV_KEYS[@]}"; do
    printf '%s=%s\n' "$key" "${values[$key]:-}"
  done
  printf 'PROVIDER_IP=%s\n' "${values[PROVIDER_HOST]%:*}"
} >"$tmp/env"
install -m 0640 -o root -g deploy "$tmp/env" "$ROOT/.env"

# Asterisk's files depend on the lines, the provider and the ARI password.
inputs=$(cat "$tmp/lines.txt" "$ROOT/internal.env" <(printf '%s\n' "${values[PROVIDER_HOST]}") | sha256sum)
if [[ $inputs != "$(cat "$ROOT/secrets/asterisk-inputs" 2>/dev/null)" ]]; then
  install -m 0600 -o root -g root "$tmp/lines.txt" "$ROOT/secrets/lines.txt"
  "$ROOT/bin/make-lines" >&2
  printf '%s\n' "$inputs" >"$ROOT/secrets/asterisk-inputs"
  echo lines-changed
fi
