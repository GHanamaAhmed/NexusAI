{
  "name": "nexus-ai",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f deploy/compose.dev.yml up -d"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
